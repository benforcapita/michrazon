# Michrazon env template — names only (LLD §14). Real values live in
# Vercel / Railway env settings, never in the repo.

# mode & legal gate
MODE=pilot                      # 'pilot' | 'paid'
BILLING_ENABLED=false           # requires LEGAL_GATE_CLEARED_AT (AC-22)
LEGAL_GATE_CLEARED_AT=          # ISO timestamp set by Ben after lawyer review

# platform
APP_BASE_URL=https://michrazon.example.com
DB_URL_WORKER=postgres://...    # service role, worker only
DB_URL_WEB=postgres://...       # service role, web only
TOKEN_HMAC_SECRET=              # shared web+worker
TOKEN_HMAC_KID=k1

# mail (Resend) — open/click tracking must be OFF on the domain (AC-11)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=whsec_...
BILLING_WEBHOOK_SECRET=         # used only once billing is enabled
SENDING_DOMAIN=example.com
REPLY_TO=
OPS_ALERT_TO=

# llm (worker only)
LLM_PROVIDER=chat_completions
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_DAILY_BUDGET=100000         # tokens/day hard cap (AC-25)
PROMPT_VERSION=v1

# source adapters
DATAGOV_RESOURCE_ID=            # CKAN resource id (TBD per LLD §4.1)
DATAGOV_RESOURCE_URL=           # direct file URL (preferred over resource id)
DATAGOV_DATASET_URL=            # dataset page — provenance + url fallback
MRGOV_LISTING_URL=              # listing URL; '{page}' placeholder or ?page=N

# identity + ops
UA_PRODUCT_URL=https://michrazon.example.com
UA_CONTACT=contact@example.com
INTERNAL_HEALTH_TOKEN=
